# Copy to .env and fill in.

# Database. Default (unset) is a local SQLite file: sqlite:///gridiron.db
# For the docker-compose Postgres:
DATABASE_URL=postgresql+psycopg://gridiron:gridiron@localhost:5432/gridiron

# CollegeFootballData API v2 key (free): https://collegefootballdata.com/key
CFBD_API_KEY=

# Override only if needed:
# CFBD_BASE_URL=https://apinext.collegefootballdata.com
# PBP_PARQUET_BASE_URL=https://github.com/sportsdataverse/sportsdataverse-data/releases/download/cfbfastR_cfb_pbp
