# Copy to .env and fill in.

# Database. Default (unset) is a local SQLite file: sqlite:///gridiron.db
# For the docker-compose Postgres:
DATABASE_URL=postgresql+psycopg://gridiron:gridiron@localhost:5432/gridiron

# CollegeFootballData API v2 key (free): https://collegefootballdata.com/key
CFBD_API_KEY=

# Override only if needed:
# CFBD_BASE_URL=https://apinext.collegefootballdata.com
# PBP_PARQUET_BASE_URL=https://github.com/sportsdataverse/sportsdataverse-data/releases/download/cfbfastR_cfb_pbp

# --- Authentication ---------------------------------------------------------
# Session-cookie signing key. REQUIRED in production (generate: `openssl rand -hex 32`).
# If unset, an ephemeral key is used and sessions reset on every restart (dev only).
# SECRET_KEY=
# Set true when served over HTTPS so the session cookie is marked Secure.
# SESSION_COOKIE_SECURE=false
# Public base URL, used for absolute links in emails (password reset).
# BASE_URL=http://127.0.0.1:8000

# Google SSO. Both required to enable the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP for password-reset email. When unset, reset links print to stdout (dev).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=gridiron@localhost
# SMTP_STARTTLS=true

# Password-reset link lifetime (minutes).
# PASSWORD_RESET_TTL_MINUTES=30
# Comma-separated emails auto-promoted to admin on login.
# ADMIN_EMAILS=
